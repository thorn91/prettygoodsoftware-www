---
const H = 1734;
const steps = [
  ['typing', 'Easy', 'One sentence per meal', 'Type it the way you would say it, or paste a recipe link. No searching, no scrolling, no scale.', 'Typing a slice of banana bread and a coffee with oat milk, with When did you eat it? chips above the box.'],
  ['meal-open', 'Accurate', 'Every food matched to real nutrition data', 'Each food on the plate gets its own calories from a nutrition database. When Tally has to estimate, it tells you.', 'Nachos with cheese and guacamole opened: tortilla chips, cheddar and guacamole, each marked Tally guessed with a question and size chips.'],
  ['review', 'Easy and accurate', 'Only check what could matter', 'When a portion is a guess big enough to move your day, Tally asks. Everything else is done.', 'Review: pho opened. No amount given, so Tally guessed 4 cups, 528 to 981 cal, and asks how big the bowl was.'],
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tally, by Pretty Good Software</title>
    <meta
      name="description"
      content="A calorie tracker for iPhone. Type what you ate in a sentence or scan a barcode; Tally looks up every food in real nutrition databases and tells you when it had to guess."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pretty Good Software" />
    <meta property="og:title" content="Tally" />
    <meta
      property="og:description"
      content="As quick as the AI apps. As accurate as the search ones."
    />
    <meta property="og:url" content="https://prettygoodsoftware.llc/tally" />
    <meta property="og:image" content="https://prettygoodsoftware.llc/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pretty Good Software, two overlapping ink circles" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://prettygoodsoftware.llc/og.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Petrona:ital,wght@0,300..600;1,300..500&family=Azeret+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="nav-wrap">
      <nav class="nav">
        <a class="wordmark" href="/">
          <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
            <clipPath id="mlens"><circle cx="40" cy="60" r="30" /></clipPath>
            <circle cx="40" cy="60" r="30" fill="#4B3A8C" />
            <circle cx="60" cy="40" r="30" fill="#E14424" />
            <circle cx="60" cy="40" r="30" fill="#420F13" clip-path="url(#mlens)" />
          </svg>
          Pretty Good Software
        </a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="mailto:tom@prettygoodsoftware.llc">Email</a>
        </div>
      </nav>
    </header>

    <section class="hero">
      <div class="inner hero-inner">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-tally eyebrow-mark">
            <svg class="eyebrow-svg" viewBox="0 0 100 100" aria-hidden="true">
              <clipPath id="tlens"><circle cx="40" cy="60" r="30" /></clipPath>
              <circle cx="40" cy="60" r="30" fill="#4B3A8C" />
              <circle cx="60" cy="40" r="30" fill="#3F6E2B" />
              <circle cx="60" cy="40" r="30" fill="#131918" clip-path="url(#tlens)" />
            </svg>
            Tally · a calorie tracker for iPhone
          </p>
          <h1>As quick as the AI apps. As accurate as the search ones.</h1>
          <p class="lede">
            Write a meal the way you would say it, like “half a turkey sandwich
            and a cup of tomato soup”. Tally looks up every food in real
            nutrition databases and logs the calories. There is no food list to
            scroll and nothing to weigh.
          </p>
          <p class="meta">iPhone · iOS 17+ · TestFlight beta</p>
        </div>
        <div class="shot-pair">
          <div class="shot">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/typing.png" width="797" height={H} alt="Typing a slice of banana bread and a coffee with oat milk, with When did you eat it? chips above the box." />
          </div>
          <div class="shot shot-low">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/log.png" width="797" height={H} alt="The Log for today: each sentence as typed, then its meal with a title, the time eaten and calories." />
          </div>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="inner">
        <p class="eyebrow eyebrow-light">Why Tally</p>
        <h2>Other calorie apps make you pick one.</h2>
        <div class="why-grid">
          <div class="why-col">
            <p class="eyebrow eyebrow-light">Search-and-pick trackers</p>
            <h3>Accurate, and a chore</h3>
            <p>Every food on the plate is its own search, a pick from a long list, and a portion to enter. It works if you keep up with it.</p>
          </div>
          <div class="why-col">
            <p class="eyebrow eyebrow-light">Snap-a-photo apps</p>
            <h3>Quick, and a guess</h3>
            <p>An AI looks at the meal and estimates everything, calories included. You can’t tell where a number came from.</p>
          </div>
          <div class="why-tally">
            <p class="eyebrow eyebrow-tally">Tally</p>
            <h3>Quick, and from real data</h3>
            <p>You type the meal in a sentence and Tally does the looking up. Calories come from real nutrition databases. When Tally has to guess or estimate, it tells you, and asks if the guess matters.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="steps">
      <div class="inner">
        <h2>Easy to log. Accurate where it counts.</h2>
        <p class="swipe-hint">3 shots, swipe</p>
        <ol class="step-grid swipe" aria-label="Easy to log, accurate where it counts, 3 shots">
          {
            steps.map(([file, tag, title, text, alt]) => (
              <li class="step">
                <div class="shot">
                  <div class="shot-offset" aria-hidden="true" />
                  <img src={`/img/tally/${file}.png`} width="797" height={H} alt={alt} loading="lazy" />
                </div>
                <p class="eyebrow eyebrow-tally step-tag">{tag}</p>
                <h3 class="step-title">{title}</h3>
                <p class="step-text">{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="split">
      <div class="inner split-inner">
        <div class="split-copy">
          <p class="eyebrow eyebrow-tally">Packaged food</p>
          <h2>Scan it instead.</h2>
          <p>Point the camera at the barcode. Tally finds the product and shows the serving and calories from its package label. One tap logs it.</p>
          <p>No barcode handy? Type the numbers under the bars. Not in any database? Describe it in words like any other meal.</p>
        </div>
        <div class="shot-pair">
          <div class="shot">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/scan.png" width="797" height={H} alt="The scanner: green corners framing where the barcode goes, Point at a barcode and Tally reads it on its own, and Type barcode." loading="lazy" />
          </div>
          <div class="shot shot-low">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/scan-found.png" width="797" height={H} alt="Found it: Pringles Crisps Original, about 15 crisps, 28 g, 150 cal, from the package label, with Log 1 serving." loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <div class="inner"><hr class="rule" /></div>

    <section class="split">
      <div class="inner split-inner">
        <div class="split-copy">
          <h2>Your day and your week</h2>
          <p>Today shows the day’s calories as a ring, one slice per meal, and what is left.</p>
          <p>Week adds up the last seven days, so a big dinner and a light lunch the next day even out. Protein, fat, carbs and sodium sit under both.</p>
        </div>
        <div class="shot-pair">
          <div class="shot">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/today.png" width="797" height={H} alt="Today: a ring of four meals at the times eaten, 1,274 of 2,000 cal, 726 left today." loading="lazy" />
          </div>
          <div class="shot shot-low">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/week.png" width="797" height={H} alt="Week, Oct 4 to 10: 10,449 cal, 3,551 under this week, averaging 1,493 a day, 7 of 7 days logged." loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section class="also">
      <div class="inner also-inner">
        <h2>Also in Tally</h2>
        <ul class="also-list">
          <li>Paste a recipe link and Tally reads the recipe from the page.</li>
          <li>Write “serves 4” and Tally logs your share.</li>
          <li>A meal you have logged before comes back in one tap.</li>
          <li>Fix a meal in words: “less rice than that”.</li>
          <li>Forgot a food? Search for it and add it.</li>
          <li>Tally needs an account: an email and a password. Your meals are stored under it.</li>
        </ul>
      </div>
    </section>

    <footer class="foot">
      <div class="inner">
        <div class="foot-grid">
          <div>
            <p class="foot-mark">Pretty Good Software</p>
            <p class="foot-tag">Small apps, shaped around the person using them.</p>
          </div>
          <div>
            <p class="eyebrow eyebrow-light">Apps</p>
            <p class="foot-link"><a href="/tally">Tally</a></p>
            <p class="foot-link">
              <a href="https://coaching.prettygoodsoftware.llc">Pretty Good Video Coaching</a>
            </p>
          </div>
          <div>
            <p class="eyebrow eyebrow-light">Contact</p>
            <p class="foot-link">
              <a href="mailto:tom@prettygoodsoftware.llc">tom@prettygoodsoftware.llc</a>
            </p>
          </div>
        </div>
        <p class="copyright"><a class="admin" href="https://tally-api.hortw1991.workers.dev/admin/ui/" aria-label="Admin">©</a> 2026 Pretty Good Software LLC</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --paper: #ecebe5;
        --paper-lit: #f6f5f1;
        --paper-warm: #f3f2ed;
        --ink: #241e1a;
        --vermilion: #e14424;
        --grape: #4b3a8c;
        --grape-lit: #6e5eab;
        --lilac: #c4b6ee;
        --muted: #5f5a53;
        --muted-soft: #6e6960;
        --rule: #c9c3b8;
        --rule-firm: #b5afa3;

        /* Product ink for Tally: the app's own green. 5.5:1 on paper, so it
           holds as text too. Overprint is grape multiplied by green. */
        --tally: #3f6e2b;
        --overprint-tally: #131918;

        --display: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
        --body: 'Petrona', ui-serif, Georgia, serif;
        --mono: 'Azeret Mono', ui-monospace, monospace;
        --gut: clamp(1.5rem, 5vw, 5rem);
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }
      * { margin: 0; }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; }
      ol { list-style: none; padding: 0; }

      .inner {
        max-width: 1180px;
        margin-inline: auto;
        padding-inline: var(--gut);
      }

      h1, h2, .wordmark, .foot-mark, .step-num {
        font-family: var(--display);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .eyebrow {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }
      .eyebrow-tally { color: var(--tally); }
      .eyebrow-light { color: var(--lilac); }
      .meta {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.68rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }

      /* ---------- nav, same as the home page ---------- */
      .nav-wrap { background: var(--paper); }
      .nav {
        max-width: 1180px;
        margin-inline: auto;
        padding: 1.6rem var(--gut) 1.1rem;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1.5px solid var(--ink);
        flex-wrap: wrap;
      }
      .wordmark {
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }
      .mark { width: 26px; height: 26px; }
      .nav-links { display: flex; gap: 1.5rem; }
      .nav-links a {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
      }
      .nav-links a:hover { color: var(--tally); }

      /* ---------- hero ---------- */
      .hero { background: var(--paper); }
      .hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
        gap: clamp(1.5rem, 4vw, 4rem);
        align-items: center;
        padding-top: clamp(3rem, 6vw, 5rem);
        padding-bottom: clamp(3.5rem, 7vw, 6rem);
      }
      .hero-copy { max-width: 46ch; }
      h1 {
        font-size: clamp(2.6rem, 5.1vw, 4.3rem);
        line-height: 1;
        margin-top: 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.35em;
      }
      .hero-mark { width: 0.85em; height: 0.85em; flex: none; }
      .lede {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        color: var(--muted);
        margin-top: 1.6rem;
        max-width: 46ch;
      }
      .hero-copy .meta { margin-top: 2rem; }

      /* The screenshot and its hard offset block in the product ink, as on
         the home page's Video Coaching card. */
      .shot {
        position: relative;
        width: 100%;
        margin-inline: auto;
      }
      .shot img { position: relative; border: 1.5px solid var(--ink); }
      .shot-offset {
        position: absolute;
        inset: 18px -18px -18px 18px;
        background: var(--tally);
      }
      .shot-hero { max-width: 300px; }

      /* The headline is a sentence now; the mark sits in the eyebrow. */
      .hero h1 { display: block; font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1.02; }
      .eyebrow-mark { display: flex; align-items: center; gap: 0.6rem; }
      .eyebrow-svg { width: 22px; height: 22px; flex: none; }
      .hero-inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
      .hero-copy { max-width: 34rem; }

      /* Two screenshots side by side, the second set lower. */
      .shot-pair {
        display: flex;
        gap: clamp(1.2rem, 3vw, 2rem);
        justify-content: center;
        align-items: flex-start;
      }
      .shot-pair .shot { flex: 0 1 230px; max-width: 230px; margin: 0 18px 18px 0; }
      .shot-pair .shot-low { margin-top: 56px; }

      /* ---------- why tally ---------- */
      .why { background: var(--grape); color: var(--paper-lit); padding-block: clamp(3.5rem, 7vw, 6rem); }
      .why h2 { margin-top: 1rem; max-width: 24ch; }
      .why-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.75rem;
        margin-top: 3rem;
      }
      .why-col { border-top: 1.5px solid var(--lilac); padding-top: 1.25rem; }
      .why-col p:last-child { color: #e4def6; margin-top: 0.6rem; max-width: 40ch; }
      .why-tally {
        background: var(--paper-lit);
        color: var(--ink);
        border: 1.5px solid var(--ink);
        box-shadow: 12px 12px 0 var(--tally);
        padding: 1.4rem 1.5rem 1.6rem;
      }
      .why-tally p:last-child { color: var(--muted); margin-top: 0.6rem; }
      .why h3, .step-title, .split h3 {
        font-family: var(--display);
        font-weight: 700;
        letter-spacing: -0.02em;
        font-size: 1.3rem;
        margin-top: 0.75rem;
      }

      /* ---------- easy and accurate ---------- */
      .step-tag { margin-top: 1.6rem; }
      .step-title { margin-top: 0.35rem; }
      .step-text { color: var(--muted); }

      /* ---------- scanner, day and week ---------- */
      .split { background: var(--paper); padding-block: clamp(3.5rem, 7vw, 6rem); }
      .split-inner {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(1.8rem, 5vw, 4.5rem);
        align-items: center;
      }
      .split h2 { margin-top: 0.8rem; }
      .split-copy p:not(.eyebrow) { color: var(--muted); margin-top: 1rem; max-width: 44ch; font-size: 1.1rem; }

      /* ---------- also ---------- */
      .also { background: var(--paper-warm); padding-block: clamp(3rem, 6vw, 5rem); }
      .also-inner {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
        gap: 2rem clamp(2rem, 5vw, 4.5rem);
      }
      .also h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
      .also-list { list-style: none; padding: 0; font-family: var(--mono); font-size: 0.85rem; line-height: 1.55; }
      .also-list li { padding-block: 0.9rem; border-top: 1px solid var(--rule-firm); }
      .also-list li:last-child { border-bottom: 1px solid var(--rule-firm); }

      .steps { background: var(--paper-warm); padding-block: clamp(3rem, 6vw, 5rem); }
      h2 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); line-height: 1.05; }
      .step-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1.5rem, 3vw, 2.5rem);
        margin-top: 2.5rem;
      }
      .step .shot { max-width: 240px; }
      .rule { border: 0; border-top: 1px solid var(--rule); }
      .swipe-hint {
        display: none;
        margin-top: 0.6rem;
        font-family: var(--mono);
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }

      /* ---------- footer, same as the home page ---------- */
      .foot { background: var(--ink); color: var(--paper-warm); padding-block: clamp(3rem, 5vw, 4.5rem); }
      .foot-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
      }
      .foot-mark { font-size: 1.6rem; }
      .foot-tag { color: var(--muted-soft); margin-top: 0.4rem; }
      .foot-link { font-family: var(--display); font-weight: 700; margin-top: 0.8rem; }
      .foot-link a { text-decoration: none; }
      .foot-link a:hover { color: var(--vermilion); }
      .copyright .admin { text-decoration: none; color: inherit; }
      .copyright {
        margin-top: 2.5rem;
        padding-top: 1.3rem;
        border-top: 1px solid #3b322c;
        color: var(--muted-soft);
        font-size: 0.85rem;
      }

      /* ---------- responsive ---------- */
      @media (max-width: 900px) {
        .hero-inner, .split-inner, .also-inner, .why-grid, .foot-grid { grid-template-columns: minmax(0, 1fr); }
        .step-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .step .shot { max-width: none; }
      }
      /* Phone: the steps swipe sideways instead of stacking. */
      @media (max-width: 520px) {
        .swipe-hint { display: block; }
        .swipe {
          display: flex;
          gap: 20px;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          margin-inline: calc(-1 * var(--gut));
          padding: 24px var(--gut) 22px;
          margin-top: 0;
        }
        .swipe > * { flex: 0 0 218px; scroll-snap-align: start; }
        .swipe .shot, .step .shot { max-width: 200px; margin: 0 18px 0 0; }
        .swipe .step-text { width: 200px; }
        .shot-pair .shot { flex: 0 1 160px; }
        .shot-pair .shot-low { margin-top: 36px; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </body>
</html>
