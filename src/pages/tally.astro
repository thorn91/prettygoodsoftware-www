---
const H = 1734;
const steps = [
  ['typing', 'Type the meal as you would say it, or paste a recipe link. Chips above the box set when you ate it: Now, An hour ago, or a meal time like Lunch, 12:30 PM.', 'The What you ate, or a recipe link box with half a turkey sandwich and a cup of tomato typed. Chips above it ask When did you eat it?, with Lunch, 12:30 PM picked and 12:30 PM in the box.'],
  ['log', "Each meal gets a short title and one calorie number, the one the day's total uses. The time you ate it shows in green on every card.", 'The Log: a burrito bowl at 12:30 PM, an apple with peanut butter at 3:50 PM and butter chicken at 4:53 PM from the page, each time in green with its calories on the right.'],
  ['meal-open', 'Open a meal to see each food on its own row, with its amount beside its calories. An amount Tally guessed is tagged Tally guessed, with one question under the row. Edit meal sits below the foods.', 'Nachos with cheese and guacamole opened: which nachos with cheese, the guacamole amount tagged Tally guessed, and Edit meal.'],
];
const recipeSteps = [
  ['link-paste', 'Paste a recipe page, with a note such as “had one bowl”. A line above the box names the site Tally will read.', 'A recipe link pasted with had one bowl; a line above the box says Tally will read the page on budgetbytes.com.'],
  ['link-reading', "While it reads, the log shows Reading and the site's name.", 'Reading budgetbytes.com… on the Log, under the pasted link.'],
  ['link-result', 'Tally logs your share from the page. The card says it came from the page, gives 468 cal a serving, and shows your share as ¼ of a recipe for 4.', 'Butter chicken at 7:24 PM, 468 cal, from the page, 468 cal a serving, your share ¼ of a recipe for 4.'],
  ['link-unread', 'When Tally cannot read a page, it logs a guess from the link and says so on the card. Tap the card to set the calories if you know them.', "Big Mac at 7:26 PM, 535 cal: Couldn't read mcdonalds.com, so this is a guess from the link."],
  ['recipe-offer', 'Type a meal you settled before and Tally offers it back first: the same foods, the same amounts, one tap. Nothing is looked up again.', 'A typed burrito bowl answered with Same as Oct 7?, its four foods with calories, and Yes, same · 490 cal.'],
  ['recipe-save', 'Save a logged meal as a recipe. Servings it makes sets how many servings the recipe is, and the sheet says what one serving comes to. The recipe is a copy of its rows; changing it later leaves the logged meal as it was.', 'Save as recipe for butter chicken: Servings it makes 4, one serving 468 cal, whole recipe 1,872 cal, and the foods.'],
  ['recipe-book', "The book next to the input holds your recipes and a starter set built from USDA survey dishes, each with its calories. A recipe that makes more than one serving shows one serving's calories.", 'Your recipes: butter chicken at 468 cal, makes 4, and a spaghetti dinner, then starter recipes with their calories.'],
  ['recipe-logged', 'A meal from last time or from a recipe says so on its card and has nothing left to review.', 'The Log with a spaghetti dinner marked your recipe, nothing to review, and a burrito bowl marked same as Oct 7.'],
];
const weekShots = [
  ['today', 'Balance on Today: a ring of four meals at the times they were eaten, 1,707 of 2,000 cal, 293 left today, then the meals.'],
  ['week-nutrients', 'The Week side scrolled: the seven-day total of 14,757 cal, 757 over this week, averaging 2,108 a day, a ring for each day, then nutrients with sodium at 26,503 mg.'],
  ['day-rings', "One day opened from the week: Monday's ring and 3,141 cal, then the meals to look at, each with its time."],
];
const fixShots = [
  ['measures', 'The portion sheet for guacamole: 2¾ tbsp, tagged Tally guessed this amount with Why?, household measures, a slider in tablespoons and the spoons drawn.'],
  ['edit-meal', 'Edit meal for nachos with cheese and guacamole: The total you know, a Bigger or smaller slider at 594 cal, Shared it? with All mine, ½, ⅓ and ¼, and the foods in this meal.'],
  ['calories', 'The Values tab on the guacamole with 90 typed into Calories; protein and fat show the estimate in grey.'],
  ['add-ingredient', 'Add an ingredient to nachos with cheese and guacamole: a USDA search for sour cream, each result with its calories per 100 g.'],
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tally, by Pretty Good Software</title>
    <meta
      name="description"
      content="An iPhone app for logging meals. Type what you ate the way you would say it, or paste a recipe link; Tally finds each food in USDA nutrition data, guesses the portion, and asks when a guess could change your day."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pretty Good Software" />
    <meta property="og:title" content="Tally" />
    <meta
      property="og:description"
      content="Type what you ate the way you would say it. Tally asks when a guess could change your day."
    />
    <meta property="og:url" content="https://prettygoodsoftware.llc/tally" />
    <meta property="og:image" content="https://prettygoodsoftware.llc/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pretty Good Software, two overlapping ink circles" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://prettygoodsoftware.llc/og.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Petrona:ital,wght@0,300..600;1,300..500&family=Azeret+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="nav-wrap">
      <nav class="nav">
        <a class="wordmark" href="/">
          <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
            <clipPath id="mlens"><circle cx="40" cy="60" r="30" /></clipPath>
            <circle cx="40" cy="60" r="30" fill="#4B3A8C" />
            <circle cx="60" cy="40" r="30" fill="#E14424" />
            <circle cx="60" cy="40" r="30" fill="#420F13" clip-path="url(#mlens)" />
          </svg>
          Pretty Good Software
        </a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="mailto:tom@prettygoodsoftware.llc">Email</a>
        </div>
      </nav>
    </header>

    <section class="hero">
      <div class="inner hero-inner">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-tally">An iPhone app</p>
          <h1>
            <!-- The product mark: same geometry as the studio mark, Tally's
                 green replacing vermilion, the lens their multiply. -->
            <svg class="hero-mark" viewBox="0 0 100 100" aria-hidden="true">
              <clipPath id="tlens"><circle cx="40" cy="60" r="30" /></clipPath>
              <circle cx="40" cy="60" r="30" fill="#4B3A8C" />
              <circle cx="60" cy="40" r="30" fill="#3F6E2B" />
              <circle cx="60" cy="40" r="30" fill="#131918" clip-path="url(#tlens)" />
            </svg>
            Tally
          </h1>
          <p class="lede">
            Type what you ate the way you would say it, or paste a recipe link.
            Tally finds each food in
            USDA nutrition data, guesses the portion, and asks when a guess could
            change your day.
          </p>
          <p class="meta">iPhone · iOS 17+ · by Pretty Good Software</p>
        </div>
        <div class="shot shot-hero">
          <div class="shot-offset" aria-hidden="true"></div>
          <img
            src="/img/tally/meal-open.png"
            width="800"
            height={H}
            alt="Nachos with cheese and guacamole opened: which nachos with cheese, the guacamole amount tagged Tally guessed, and Edit meal."
          />
        </div>
      </div>
    </section>

    <section class="steps">
      <div class="inner">
        <h2>Logging a meal</h2>
        <p class="swipe-hint">3 shots, swipe</p>
        <ol class="step-grid swipe" aria-label="Logging a meal, 3 shots">
          {
            steps.map(([file, text, alt], i) => (
              <li class="step">
                <div class="shot">
                  <div class="shot-offset" aria-hidden="true" />
                  <img src={`/img/tally/${file}.png`} width="800" height={H} alt={alt} loading="lazy" />
                </div>
                <p class="step-num">0{i + 1}</p>
                <p class="step-text">{text}</p>
              </li>
            ))
          }
        </ol>
        <div class="share">
          <div class="shot shot-share">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/share.png" width="800" height={H} alt="Made a pasta bake with sausage and mozzarella, serves 4: the card says Your share: ¼ of a recipe for 4, with Change." loading="lazy" />
          </div>
          <div class="share-copy">
            <p>
              Write “serves 4” and Tally logs your part. The card says Your
              share: ¼ of a recipe for 4, with Change beside it.
            </p>
            <p class="steps-note">
              Tally also asks which food you meant when the matching foods in the
              USDA search would differ by 50 cal or more at the amount you logged.
              Each answer shows what it comes to in calories.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="recipes">
      <div class="inner">
        <h2>Meals you eat again</h2>
        <p class="swipe-hint">8 shots, swipe</p>
        <ol class="step-grid swipe" aria-label="Meals you eat again, 8 shots">
          {
            recipeSteps.map(([file, text, alt], i) => (
              <li class="step">
                <div class="shot">
                  <div class="shot-offset" aria-hidden="true" />
                  <img src={`/img/tally/${file}.png`} width="800" height={H} alt={alt} loading="lazy" />
                </div>
                <p class="step-num">0{i + 1}</p>
                <p class="step-text">{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <div class="inner"><hr class="rule" /></div>

    <section class="review">
      <div class="inner review-inner">
        <div class="review-copy">
          <h2>Review</h2>
          <p>
            Review lists the foods where Tally's guess could move your week.
            Until you settle one, the estimate still counts.
          </p>
          <p>
            Open a row to see why Tally chose its amount and the range it could
            be, such as 1¾ cups at 469–861 cal. The slider and sizes use the
            row's own unit. Confirm settles the row and it becomes yours, or use
            “Tell Tally” to re-ask in your own words.
          </p>
        </div>
        <div class="shot shot-review">
          <div class="shot-offset" aria-hidden="true"></div>
          <img src="/img/tally/review.png" width="800" height={H} alt="The Review tab: the first row open with Tally's reasoning, 469-861 cal, which-food answers, 1¾ cups and a slider." loading="lazy" />
        </div>
      </div>
    </section>

    <div class="inner"><hr class="rule" /></div>

    <section class="week">
      <div class="inner week-inner">
        <div class="week-copy">
          <h2>Today and the week</h2>
          <p>
            Balance opens on Today. The ring is the day's calories and each
            slice is one meal, placed at the time you ate it. Under it, Tally
            says how many calories are left today. A Today and Week switch sits
            at the top.
          </p>
          <p>
            Nutrients list protein, fat and carbs, with sodium in mg under them,
            on both Today and Week.
          </p>
          <p>
            Week is the other side of the switch: the rolling seven-day total,
            how far over or under you are, the daily average, and a ring for each
            day. Seven days is the cap; a surplus or deficit is not spread further
            than that.
          </p>
          <p>
            Each day opens on its own: the day's total as one number, then the
            meals that still need a look above the ones that are settled.
          </p>
        </div>
        <div>
          <p class="swipe-hint">3 shots, swipe</p>
          <div class="trio swipe" role="list" aria-label="Today and the week, 3 shots">
            {
              weekShots.map(([file, alt]) => (
                <div class="shot" role="listitem">
                  <div class="shot-offset" aria-hidden="true" />
                  <img src={`/img/tally/${file}.png`} width="800" height={H} alt={alt} loading="lazy" />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="fix">
      <div class="inner fix-inner">
        <div>
          <p class="swipe-hint">4 shots, swipe</p>
          <div class="pair swipe" role="list" aria-label="Corrections and the range, 4 shots">
            {
              fixShots.map(([file, alt]) => (
                <div class="shot" role="listitem">
                  <div class="shot-offset" aria-hidden="true" />
                  <img src={`/img/tally/${file}.png`} width="800" height={H} alt={alt} loading="lazy" />
                </div>
              ))
            }
          </div>
        </div>
        <div class="fix-copy">
          <h2>Corrections and the range</h2>
          <p>
            Each amount says where it came from. One Tally guessed is tagged
            Tally guessed, and Why? gives the range and the reason. Rows show
            amounts such as 1 slice, 1 tbsp or 2¾ cups beside their calories.
            Cards show one number; the range appears in Review and behind Why?.
          </p>
          <p>
            The portion sheet shows the amount in the unit a menu would use
            (ounces, cups, spoons or slices), the household measures USDA knows
            for the food, a slider in that unit, and the amount drawn out.
          </p>
          <p>
            Edit meal is on every open card. Enter the total you know, from a
            label, a recipe or a menu, and the foods share it the way they're
            logged. Or make the meal bigger or smaller, say you shared it, or
            change its foods.
          </p>
          <p>
            On a food's Values tab, a calorie number sets the food: 90 cal on the
            guacamole replaces the estimate, and blank fields keep it.
          </p>
          <p>
            If you forgot a food, open the logged meal, tap Add and search USDA.
            Pick the food and an amount. What you add is yours, so it skips
            review.
          </p>
          <p>
            Tally keeps the text you typed as you typed it. Corrections sit in a
            separate layer on top of it, and each one says who made it.
          </p>
          <h2 class="h2-account">Account</h2>
          <p>
            Tally needs an account: an email and a password. Your meals are
            stored under that account.
          </p>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="inner">
        <div class="foot-grid">
          <div>
            <p class="foot-mark">Pretty Good Software</p>
            <p class="foot-tag">Small apps, shaped around the person using them.</p>
          </div>
          <div>
            <p class="eyebrow eyebrow-light">Apps</p>
            <p class="foot-link"><a href="/tally">Tally</a></p>
            <p class="foot-link">
              <a href="https://coaching.prettygoodsoftware.llc">Pretty Good Video Coaching</a>
            </p>
          </div>
          <div>
            <p class="eyebrow eyebrow-light">Contact</p>
            <p class="foot-link">
              <a href="mailto:tom@prettygoodsoftware.llc">tom@prettygoodsoftware.llc</a>
            </p>
          </div>
        </div>
        <p class="copyright"><a class="admin" href="https://tally-api.hortw1991.workers.dev/admin/ui/" aria-label="Admin">©</a> 2026 Pretty Good Software LLC</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --paper: #ecebe5;
        --paper-lit: #f6f5f1;
        --paper-warm: #f3f2ed;
        --ink: #241e1a;
        --vermilion: #e14424;
        --grape: #4b3a8c;
        --grape-lit: #6e5eab;
        --lilac: #c4b6ee;
        --muted: #5f5a53;
        --muted-soft: #6e6960;
        --rule: #c9c3b8;
        --rule-firm: #b5afa3;

        /* Product ink for Tally: the app's own green. 5.5:1 on paper, so it
           holds as text too. Overprint is grape multiplied by green. */
        --tally: #3f6e2b;
        --overprint-tally: #131918;

        --display: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
        --body: 'Petrona', ui-serif, Georgia, serif;
        --mono: 'Azeret Mono', ui-monospace, monospace;
        --gut: clamp(1.5rem, 5vw, 5rem);
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }
      * { margin: 0; }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; }
      ol { list-style: none; padding: 0; }

      .inner {
        max-width: 1180px;
        margin-inline: auto;
        padding-inline: var(--gut);
      }

      h1, h2, .wordmark, .foot-mark, .step-num {
        font-family: var(--display);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .eyebrow {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }
      .eyebrow-tally { color: var(--tally); }
      .eyebrow-light { color: var(--lilac); }
      .meta {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.68rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }

      /* ---------- nav, same as the home page ---------- */
      .nav-wrap { background: var(--paper); }
      .nav {
        max-width: 1180px;
        margin-inline: auto;
        padding: 1.6rem var(--gut) 1.1rem;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1.5px solid var(--ink);
        flex-wrap: wrap;
      }
      .wordmark {
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }
      .mark { width: 26px; height: 26px; }
      .nav-links { display: flex; gap: 1.5rem; }
      .nav-links a {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
      }
      .nav-links a:hover { color: var(--tally); }

      /* ---------- hero ---------- */
      .hero { background: var(--paper); }
      .hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
        gap: clamp(1.5rem, 4vw, 4rem);
        align-items: center;
        padding-top: clamp(3rem, 6vw, 5rem);
        padding-bottom: clamp(3.5rem, 7vw, 6rem);
      }
      .hero-copy { max-width: 46ch; }
      h1 {
        font-size: clamp(2.6rem, 5.1vw, 4.3rem);
        line-height: 1;
        margin-top: 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.35em;
      }
      .hero-mark { width: 0.85em; height: 0.85em; flex: none; }
      .lede {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        color: var(--muted);
        margin-top: 1.6rem;
        max-width: 46ch;
      }
      .hero-copy .meta { margin-top: 2rem; }

      /* The screenshot and its hard offset block in the product ink, as on
         the home page's Video Coaching card. */
      .shot {
        position: relative;
        width: 100%;
        margin-inline: auto;
      }
      .shot img { position: relative; border: 1.5px solid var(--ink); }
      .shot-offset {
        position: absolute;
        inset: 18px -18px -18px 18px;
        background: var(--tally);
      }
      .shot-hero { max-width: 300px; }

      /* ---------- logging a meal ---------- */
      .steps { background: var(--paper-warm); padding-block: clamp(3rem, 6vw, 5rem); }
      h2 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); line-height: 1.05; }
      .step-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
        gap: clamp(1.5rem, 3vw, 2.5rem);
        margin-top: 2rem;
      }
      .step .shot { max-width: 240px; }
      .step-num {
        color: var(--tally);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        margin-top: 1.6rem;
      }
      .step-text { color: var(--ink); margin-top: 0.4rem; max-width: 30ch; }
      .recipes { background: var(--paper); padding-block: clamp(3rem, 6vw, 5rem); }
      .steps-note { margin-top: 2rem; max-width: 60ch; }
      .recipes .step-grid { row-gap: clamp(2rem, 4vw, 3rem); }
      .share {
        margin-top: 3rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 2rem clamp(1.8rem, 5vw, 4rem);
      }
      .shot-share { flex: 0 1 234px; max-width: 234px; margin: 0 18px 18px 0; }
      .share-copy { flex: 1 1 320px; }
      .share-copy p:first-child { max-width: 46ch; }
      .swipe-hint {
        display: none;
        margin-top: 0.6rem;
        font-family: var(--mono);
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }

      /* ---------- review ---------- */
      .review { background: var(--paper); padding-top: clamp(3.5rem, 7vw, 6rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
      .review-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(1.8rem, 5vw, 4rem);
        align-items: center;
      }
      .shot-review { max-width: 300px; }
      .rule { border: 0; border-top: 1px solid var(--rule); }

      /* ---------- the week ---------- */
      .week { background: var(--paper); padding-block: clamp(3.5rem, 7vw, 6rem); }
      .week-inner {
        display: grid;
        grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
        gap: clamp(1.8rem, 5vw, 4rem);
        align-items: center;
      }
      .week-copy p, .fix-copy p, .review-copy p { color: var(--muted); margin-top: 1rem; max-width: 46ch; }
      .trio {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1.2rem, 2.5vw, 2rem);
      }
      .trio .shot { max-width: 220px; }

      /* ---------- corrections and the range ---------- */
      .fix { background: var(--paper-warm); padding-block: clamp(3.5rem, 7vw, 6rem); }
      .fix-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: clamp(1.8rem, 5vw, 4rem);
        align-items: center;
      }
      .pair {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2.2rem 1.8rem;
      }
      .pair .shot { max-width: 240px; }
      .h2-account { margin-top: 2.4rem; }

      /* ---------- footer, same as the home page ---------- */
      .foot { background: var(--ink); color: var(--paper-warm); padding-block: clamp(3rem, 5vw, 4.5rem); }
      .foot-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
      }
      .foot-mark { font-size: 1.6rem; }
      .foot-tag { color: var(--muted-soft); margin-top: 0.4rem; }
      .foot-link { font-family: var(--display); font-weight: 700; margin-top: 0.8rem; }
      .foot-link a { text-decoration: none; }
      .foot-link a:hover { color: var(--vermilion); }
      .copyright .admin { text-decoration: none; color: inherit; }
      .copyright {
        margin-top: 2.5rem;
        padding-top: 1.3rem;
        border-top: 1px solid #3b322c;
        color: var(--muted-soft);
        font-size: 0.85rem;
      }

      /* ---------- responsive ---------- */
      @media (max-width: 900px) {
        .hero-inner, .review-inner, .week-inner, .fix-inner, .foot-grid { grid-template-columns: minmax(0, 1fr); }
        .shot-hero { max-width: 280px; margin-top: 1rem; }
        .step-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .step .shot, .trio .shot, .pair .shot { max-width: none; }
        .week-inner .trio { order: 2; }
        .fix-inner .pair { order: 2; }
      }
      /* Phone: each row of shots swipes sideways instead of stacking. */
      @media (max-width: 520px) {
        .swipe-hint { display: block; }
        .swipe {
          display: flex;
          gap: 20px;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          margin-inline: calc(-1 * var(--gut));
          padding: 24px var(--gut) 22px;
          margin-top: 0;
        }
        .swipe > * { flex: 0 0 218px; scroll-snap-align: start; }
        .swipe .shot, .step .shot { max-width: 200px; margin: 0 18px 0 0; }
        .swipe .step-text { width: 200px; }
        .shot-share { max-width: 200px; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </body>
