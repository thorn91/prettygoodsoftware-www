---
const steps = [
  ['typing', 'Type the meal as you would say it.', 'The What did you eat field with a meal half typed and the keyboard up.'],
  ['log', "Each meal gets a short title and one calorie number, the one the day's total uses.", 'The Log tab with three meal cards, each with a short title and one calorie number.'],
  ['meal-open', 'Open a meal to see each food on its own row. When Tally guessed an amount, it asks one question under the row. Its own guess is the dashed button marked “guess”.', 'A nachos meal opened: a food question with a dashed guess button, and a question about how much guacamole.'],
  ['portion', 'To change an amount, open the portion sheet. The calorie range appears here, with “Why this range” underneath.', 'The portion sheet for guacamole: the amount as ¼ cup, a slider in cups, household measures, a measuring cup drawn to the amount, and Why this range underneath.'],
];
const recipeSteps = [
  ['recipe-offer', 'Type a meal you settled before and Tally offers it back first: the same foods, the same amounts, one tap. Nothing is looked up again.', 'A typed burrito bowl answered with Same as Oct 4?, its three foods, and a Yes, same button.'],
  ['recipe-save', 'Save any logged meal as a recipe. The recipe is a copy of its rows; changing it later leaves the logged meal as it was.', 'The Save as recipe sheet for a spaghetti dinner: name, category, and the four foods with amounts in cups and spoons and their calories.'],
  ['recipe-book', 'The book next to the input holds your recipes and a starter set built from USDA survey dishes. Pick half, one, two servings or grams.', 'The recipe book filtered to Dinner: a saved spaghetti dinner with half, one, two and grams, then starter recipes.'],
  ['recipe-logged', 'A meal from last time or from a recipe says so on its card and has nothing left to review.', 'The Log with a burrito bowl marked same as Oct 4 and a spaghetti dinner marked your recipe.'],
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tally, by Pretty Good Software</title>
    <meta
      name="description"
      content="An iPhone app for logging meals. Type what you ate the way you would say it; Tally finds each food in USDA nutrition data, guesses the portion, and asks when a guess could change your day."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pretty Good Software" />
    <meta property="og:title" content="Tally" />
    <meta
      property="og:description"
      content="Type what you ate the way you would say it. Tally asks when a guess could change your day."
    />
    <meta property="og:url" content="https://prettygoodsoftware.llc/tally" />
    <meta property="og:image" content="https://prettygoodsoftware.llc/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pretty Good Software, two overlapping ink circles" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://prettygoodsoftware.llc/og.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Petrona:ital,wght@0,300..600;1,300..500&family=Azeret+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="nav-wrap">
      <nav class="nav">
        <a class="wordmark" href="/">
          <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
            <clipPath id="mlens"><circle cx="40" cy="60" r="30" /></clipPath>
            <circle cx="40" cy="60" r="30" fill="#4B3A8C" />
            <circle cx="60" cy="40" r="30" fill="#E14424" />
            <circle cx="60" cy="40" r="30" fill="#420F13" clip-path="url(#mlens)" />
          </svg>
          Pretty Good Software
        </a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="mailto:tom@prettygoodsoftware.llc">Email</a>
        </div>
      </nav>
    </header>

    <section class="hero">
      <div class="inner hero-inner">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-tally">An iPhone app</p>
          <h1>
            <!-- The product mark: same geometry as the studio mark, Tally's
                 green replacing vermilion, the lens their multiply. -->
            <svg class="hero-mark" viewBox="0 0 100 100" aria-hidden="true">
              <clipPath id="tlens"><circle cx="40" cy="60" r="30" /></clipPath>
              <circle cx="40" cy="60" r="30" fill="#4B3A8C" />
              <circle cx="60" cy="40" r="30" fill="#3F6E2B" />
              <circle cx="60" cy="40" r="30" fill="#131918" clip-path="url(#tlens)" />
            </svg>
            Tally
          </h1>
          <p class="lede">
            Type what you ate the way you would say it. Tally finds each food in
            USDA nutrition data, guesses the portion, and asks when a guess could
            change your day.
          </p>
          <p class="meta">iPhone · iOS 17+ · by Pretty Good Software</p>
        </div>
        <div class="shot shot-hero">
          <div class="shot-offset" aria-hidden="true"></div>
          <img
            src="/img/tally/question.png"
            width="800"
            height="1739"
            alt="A logged meal of nachos with cheese and guacamole, each food with its question and answer buttons."
          />
        </div>
      </div>
    </section>

    <section class="steps">
      <div class="inner">
        <h2>Logging a meal</h2>
        <ol class="step-grid">
          {
            steps.map(([file, text, alt], i) => (
              <li class="step">
                <div class="shot">
                  <div class="shot-offset" aria-hidden="true" />
                  <img src={`/img/tally/${file}.png`} width="800" height="1739" alt={alt} loading="lazy" />
                </div>
                <p class="step-num">0{i + 1}</p>
                <p class="step-text">{text}</p>
              </li>
            ))
          }
        </ol>
        <p class="steps-note">
          Tally also asks which food you meant when the matching foods in the
          USDA search would differ by 50 cal or more at the amount you logged.
        </p>
      </div>
    </section>

    <section class="recipes">
      <div class="inner">
        <h2>Meals you eat again</h2>
        <ol class="step-grid">
          {
            recipeSteps.map(([file, text, alt], i) => (
              <li class="step">
                <div class="shot">
                  <div class="shot-offset" aria-hidden="true" />
                  <img src={`/img/tally/${file}.png`} width="800" height="1739" alt={alt} loading="lazy" />
                </div>
                <p class="step-num">0{i + 1}</p>
                <p class="step-text">{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <div class="inner"><hr class="rule" /></div>

    <section class="review">
      <div class="inner review-inner">
        <div class="review-copy">
          <h2>Review</h2>
          <p>
            Review lists the foods where Tally's guess could move your week.
            Until you settle one, the estimate still counts.
          </p>
          <p>
            Tap a size to answer a question and the row becomes yours, or use
            “Tell Tally” to re-ask in your own words.
          </p>
        </div>
        <div class="shot shot-review">
          <div class="shot-offset" aria-hidden="true"></div>
          <img src="/img/tally/review.png" width="800" height="1739" alt="The Review tab: a guacamole question with amount buttons, then a Needs you list of four rows." loading="lazy" />
        </div>
      </div>
    </section>

    <div class="inner"><hr class="rule" /></div>

    <section class="week">
      <div class="inner week-inner">
        <div class="week-copy">
          <h2>The week</h2>
          <p>
            Your balance is a rolling seven-day total, not a daily score. Seven
            days is the cap; a surplus or deficit is not spread further than
            that.
          </p>
          <p>
            Each day opens on its own: the day's total as one number, then the
            meals that still need a look above the ones that are settled.
          </p>
        </div>
        <div class="trio">
          <div class="shot">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/week.png" width="800" height="1739" alt="The week: a ring with the seven-day total, the pace line, macros, and seven small day rings." loading="lazy" />
          </div>
          <div class="shot">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/day-rings.png" width="800" height="1739" alt="One day opened from the week: the day's ring and total, then the meals that still need a look." loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section class="fix">
      <div class="inner fix-inner">
        <div class="pair">
          <div class="shot">
            <div class="shot-offset" aria-hidden="true"></div>
            <img src="/img/tally/measures.png" width="800" height="1739" alt="The portion sheet on a ham sandwich: the amount as 1 regular, a slider in that unit, slider and regular as measures, and the amount drawn out." loading="lazy" />
          </div>
        </div>
        <div class="fix-copy">
          <h2>Corrections and the range</h2>
          <p>
            Rows and cards show one number. The range appears on the portion
            sheet, with “Why this range” underneath. The sheet shows the amount in
            the unit a menu would use (ounces, cups, spoons or slices), a slider
            in that unit, the household measures USDA knows for the food, and the
            amount drawn out.
          </p>
          <p>
            Tally keeps the text you typed as you typed it. Corrections sit in a
            separate layer on top of it, and each one says who made it.
          </p>
          <h2 class="h2-account">Account</h2>
          <p>
            Tally needs an account: an email and a password. Your meals are
            stored under that account.
          </p>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="inner">
        <div class="foot-grid">
          <div>
            <p class="foot-mark">Pretty Good Software</p>
            <p class="foot-tag">Small apps, shaped around the person using them.</p>
          </div>
          <div>
            <p class="eyebrow eyebrow-light">Apps</p>
            <p class="foot-link"><a href="/tally">Tally</a></p>
            <p class="foot-link">
              <a href="https://coaching.prettygoodsoftware.llc">Pretty Good Video Coaching</a>
            </p>
          </div>
          <div>
            <p class="eyebrow eyebrow-light">Contact</p>
            <p class="foot-link">
              <a href="mailto:tom@prettygoodsoftware.llc">tom@prettygoodsoftware.llc</a>
            </p>
          </div>
        </div>
        <p class="copyright"><a class="admin" href="https://tally-api.hortw1991.workers.dev/admin/ui/" aria-label="Admin">©</a> 2026 Pretty Good Software LLC</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --paper: #ecebe5;
        --paper-lit: #f6f5f1;
        --paper-warm: #f3f2ed;
        --ink: #241e1a;
        --vermilion: #e14424;
        --grape: #4b3a8c;
        --grape-lit: #6e5eab;
        --lilac: #c4b6ee;
        --muted: #5f5a53;
        --muted-soft: #6e6960;
        --rule: #c9c3b8;
        --rule-firm: #b5afa3;

        /* Product ink for Tally: the app's own green. 5.5:1 on paper, so it
           holds as text too. Overprint is grape multiplied by green. */
        --tally: #3f6e2b;
        --overprint-tally: #131918;

        --display: 'Familjen Grotesk', ui-sans-serif, system-ui, sans-serif;
        --body: 'Petrona', ui-serif, Georgia, serif;
        --mono: 'Azeret Mono', ui-monospace, monospace;
        --gut: clamp(1.5rem, 5vw, 5rem);
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }
      * { margin: 0; }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; }
      ol { list-style: none; padding: 0; }

      .inner {
        max-width: 1180px;
        margin-inline: auto;
        padding-inline: var(--gut);
      }

      h1, h2, .wordmark, .foot-mark, .step-num {
        font-family: var(--display);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .eyebrow {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }
      .eyebrow-tally { color: var(--tally); }
      .eyebrow-light { color: var(--lilac); }
      .meta {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.68rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--muted-soft);
      }

      /* ---------- nav, same as the home page ---------- */
      .nav-wrap { background: var(--paper); }
      .nav {
        max-width: 1180px;
        margin-inline: auto;
        padding: 1.6rem var(--gut) 1.1rem;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1.5px solid var(--ink);
        flex-wrap: wrap;
      }
      .wordmark {
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }
      .mark { width: 26px; height: 26px; }
      .nav-links { display: flex; gap: 1.5rem; }
      .nav-links a {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
      }
      .nav-links a:hover { color: var(--tally); }

      /* ---------- hero ---------- */
      .hero { background: var(--paper); }
      .hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
        gap: clamp(1.5rem, 4vw, 4rem);
        align-items: center;
        padding-top: clamp(3rem, 6vw, 5rem);
        padding-bottom: clamp(3.5rem, 7vw, 6rem);
      }
      .hero-copy { max-width: 46ch; }
      h1 {
        font-size: clamp(2.6rem, 5.1vw, 4.3rem);
        line-height: 1;
        margin-top: 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.35em;
      }
      .hero-mark { width: 0.85em; height: 0.85em; flex: none; }
      .lede {
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        color: var(--muted);
        margin-top: 1.6rem;
        max-width: 46ch;
      }
      .hero-copy .meta { margin-top: 2rem; }

      /* The screenshot and its hard offset block in the product ink, as on
         the home page's Video Coaching card. */
      .shot {
        position: relative;
        width: 100%;
        margin-inline: auto;
      }
      .shot img { position: relative; border: 1.5px solid var(--ink); }
      .shot-offset {
        position: absolute;
        inset: 18px -18px -18px 18px;
        background: var(--tally);
      }
      .shot-hero { max-width: 300px; }

      /* ---------- logging a meal ---------- */
      .steps { background: var(--paper-warm); padding-block: clamp(3rem, 6vw, 5rem); }
      h2 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); line-height: 1.05; }
      .step-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: clamp(1.5rem, 3vw, 2.5rem);
        margin-top: 2rem;
      }
      .step .shot { max-width: 240px; }
      .step-num {
        color: var(--tally);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        margin-top: 1.6rem;
      }
      .step-text { color: var(--ink); margin-top: 0.4rem; max-width: 30ch; }
      .recipes { background: var(--paper); padding-block: clamp(3rem, 6vw, 5rem); }
      .steps-note { margin-top: 3rem; max-width: 60ch; }

      /* ---------- review ---------- */
      .review { background: var(--paper); padding-top: clamp(3.5rem, 7vw, 6rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
      .review-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(1.8rem, 5vw, 4rem);
        align-items: center;
      }
      .shot-review { max-width: 300px; }
      .rule { border: 0; border-top: 1px solid var(--rule); }

      /* ---------- the week ---------- */
      .week { background: var(--paper); padding-block: clamp(3.5rem, 7vw, 6rem); }
      .week-inner {
        display: grid;
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
        gap: clamp(1.8rem, 5vw, 4rem);
        align-items: center;
      }
      .week-copy p, .fix-copy p, .review-copy p { color: var(--muted); margin-top: 1rem; max-width: 46ch; }
      .trio {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(1.2rem, 2.5vw, 2rem);
      }
      .trio .shot { max-width: 220px; }

      /* ---------- corrections and the range ---------- */
      .fix { background: var(--paper-warm); padding-block: clamp(3.5rem, 7vw, 6rem); }
      .fix-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: clamp(1.8rem, 5vw, 4rem);
        align-items: center;
      }
      .pair {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(1.2rem, 2.5vw, 2rem);
      }
      .pair .shot { max-width: 240px; }
      .h2-account { margin-top: 2.4rem; }

      /* ---------- footer, same as the home page ---------- */
      .foot { background: var(--ink); color: var(--paper-warm); padding-block: clamp(3rem, 5vw, 4.5rem); }
      .foot-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
      }
      .foot-mark { font-size: 1.6rem; }
      .foot-tag { color: var(--muted-soft); margin-top: 0.4rem; }
      .foot-link { font-family: var(--display); font-weight: 700; margin-top: 0.8rem; }
      .foot-link a { text-decoration: none; }
      .foot-link a:hover { color: var(--vermilion); }
      .copyright .admin { text-decoration: none; color: inherit; }
      .copyright {
        margin-top: 2.5rem;
        padding-top: 1.3rem;
        border-top: 1px solid #3b322c;
        color: var(--muted-soft);
        font-size: 0.85rem;
      }

      /* ---------- responsive ---------- */
      @media (max-width: 900px) {
        .hero-inner, .review-inner, .week-inner, .fix-inner, .foot-grid { grid-template-columns: minmax(0, 1fr); }
        .shot-hero { max-width: 280px; margin-top: 1rem; }
        .step-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .step .shot, .trio .shot, .pair .shot { max-width: none; }
        .week-inner .trio { order: 2; }
        .fix-inner .pair { order: 2; }
      }
      @media (max-width: 520px) {
        .step-grid { grid-template-columns: minmax(0, 1fr); }
        .step .shot, .pair .shot { max-width: 280px; }
        .trio { grid-template-columns: minmax(0, 1fr); }
        .trio .shot { max-width: 280px; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </body>
</html>
